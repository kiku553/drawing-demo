# ==========================================================
# 座標取得（fabric.js のパス → 点列）
# ==========================================================
def quad_bezier(p0, p1, p2, n=8):
    """2次ベジェ曲線を n 点にサンプリングする"""
    t = np.linspace(0.0, 1.0, n)[:, None]
    p0, p1, p2 = np.array(p0, float), np.array(p1, float), np.array(p2, float)
    return (1 - t) ** 2 * p0 + 2 * (1 - t) * t * p1 + t**2 * p2


def path_to_points(path):
    """
    fabric.js のパス命令を (x, y) の点列に変換する。
    freedraw は ["M",x,y] / ["Q",cx,cy,x,y] / ["L",x,y] を返すので、
    命令ごとに引数の数が違う点に注意（Q の cmd[1],cmd[2] は制御点であって通過点ではない）。
    """
    pts, cur = [], None
    for cmd in path:
        op = cmd[0]
        if op in ("M", "L"):
            cur = [cmd[1], cmd[2]]
            pts.append(cur)
        elif op == "Q" and cur is not None:
            seg = quad_bezier(cur, [cmd[1], cmd[2]], [cmd[3], cmd[4]])
            pts.extend(seg[1:].tolist())
            cur = [cmd[3], cmd[4]]
        elif op == "C" and cur is not None:
            cur = [cmd[5], cmd[6]]
            pts.append(cur)

    if len(pts) < 2:
        return np.zeros((0, 2))

    pts = np.asarray(pts, dtype=float)
    # 連続する重複点を除去（重複があるとRDPでゼロ除算が起きる）
    keep = np.ones(len(pts), dtype=bool)
    keep[1:] = np.hypot(pts[1:, 0] - pts[:-1, 0], pts[1:, 1] - pts[:-1, 1]) > 1e-9
    return pts[keep]


# ==========================================================
# RDP法アルゴリズム
# ==========================================================
def perpendicular_distance(point, start, end):
    """直線 start-end と点 point の距離を計算する"""
    x, y = point[0], point[1]
    x1, y1 = start[0], start[1]
    x2, y2 = end[0], end[1]

    denom = np.hypot(y2 - y1, x2 - x1)
    if denom == 0:
        # start と end が同一点のときは点と点の距離を返す（ゼロ除算の回避）
        return float(np.hypot(x - x1, y - y1))

    return float(abs((y2 - y1) * x - (x2 - x1) * y + x2 * y1 - y2 * x1) / denom)


def douglas_peucker(point_list, start, end, epsilon):
    """point_list[start:end] を簡略化した点列を返す（end は含まない）"""
    # 点が2個以下ならこれ以上簡略化できない（再帰の終了条件）
    if end - start <= 1:
        return [point_list[start]]
    if end - start == 2:
        return [point_list[start], point_list[end - 1]]

    # 直線からの距離が最大の点を見つける
    dmax, index = 0.0, start + 1
    for i in range(start + 1, end - 1):
        d = perpendicular_distance(point_list[i], point_list[start], point_list[end - 1])
        if d > dmax:
            index, dmax = i, d

    # 最大距離が閾値を超えた場合、再帰的に処理する
    if dmax > epsilon:
        rec_results1 = douglas_peucker(point_list, start, index + 1, epsilon)
        rec_results2 = douglas_peucker(point_list, index, end, epsilon)

        # 結果を結合する（分岐点が重複するので先頭を除いて連結）
        rec_results1.extend(rec_results2[1:])
        return rec_results1
    else:
        return [point_list[start], point_list[end - 1]]


def douglas_peucker_indices(points, epsilon):
    """RDPで残る点の「添字」を返す（線分/円弧の判定で元の点列を参照するため）"""
    n = len(points)
    if n < 3:
        return list(range(n))

    keep = {0, n - 1}
    stack = [(0, n - 1)]
    while stack:  # 再帰の深さ制限に引っかからないようスタックで実装
        s, e = stack.pop()
        if e - s < 2:
            continue
        dmax, index = 0.0, -1
        for i in range(s + 1, e):
            d = perpendicular_distance(points[i], points[s], points[e])
            if d > dmax:
                dmax, index = d, i
        if dmax > epsilon and index > 0:
            keep.add(index)
            stack.append((s, index))
            stack.append((index, e))
    return sorted(keep)


# ==========================================================
# 線分 / 円弧のあてはめ
# ==========================================================
def line_error(pts):
    """両端を結ぶ直線からの最大ずれ"""
    if len(pts) < 3:
        return 0.0
    return max(perpendicular_distance(p, pts[0], pts[-1]) for p in pts[1:-1])


def fit_circle(pts):
    """最小二乗による円あてはめ（Kasa法）。(cx, cy, r) を返す。失敗時は None"""
    if len(pts) < 3:
        return None
    x, y = pts[:, 0], pts[:, 1]
    A = np.column_stack([x, y, np.ones(len(x))])
    b = x**2 + y**2
    try:
        sol, *_ = np.linalg.lstsq(A, b, rcond=None)
    except np.linalg.LinAlgError:
        return None
    cx, cy = sol[0] / 2.0, sol[1] / 2.0
    val = sol[2] + cx**2 + cy**2
    if not np.isfinite(val) or val <= 0:
        return None
    return float(cx), float(cy), float(np.sqrt(val))


def arc_error(pts, circle):
    """円からの最大ずれ"""
    cx, cy, r = circle
    return float(np.max(np.abs(np.hypot(pts[:, 0] - cx, pts[:, 1] - cy) - r)))


def arc_angles(pts, circle):
    """点列に沿って角度を連続化し、(開始角, 終了角) を返す"""
    cx, cy, _ = circle
    ang = np.unwrap(np.arctan2(pts[:, 1] - cy, pts[:, 0] - cx))
    return float(ang[0]), float(ang[-1])


def make_line(points, i0, i1):
    sub = points[i0 : i1 + 1]
    return {
        "type": "線分", "i0": i0, "i1": i1,
        "start": sub[0], "end": sub[-1],
        "length": float(np.hypot(*(sub[-1] - sub[0]))),
        "error": line_error(sub),
    }


def make_arc(points, i0, i1, circle):
    sub = points[i0 : i1 + 1]
    a0, a1 = arc_angles(sub, circle)
    return {
        "type": "円弧", "i0": i0, "i1": i1,
        "center": (circle[0], circle[1]), "radius": circle[2],
        "a0": a0, "a1": a1,
        "error": arc_error(sub, circle),
        "start": sub[0], "end": sub[-1],
    }


def merge_primitives(points, prims, tol):
    """RDPの頂点が細かすぎて分断された図形を、同じ図形とみなせる範囲で結合する"""
    merged = []
    for p in prims:
        if merged:
            prev = merged[-1]
            sub = points[prev["i0"] : p["i1"] + 1]

            # 隣り合う線分どうしが1本の直線とみなせるなら結合
            if prev["type"] == "線分" and p["type"] == "線分" and line_error(sub) <= tol * 1.5:
                merged[-1] = make_line(points, prev["i0"], p["i1"])
                continue

            # 円弧に隣接する短い区間が同じ円に乗るなら円弧に吸収させる
            if prev["type"] == "円弧" or p["type"] == "円弧":
                c = fit_circle(sub)
                if c is not None and arc_error(sub, c) <= tol * 1.5:
                    merged[-1] = make_arc(points, prev["i0"], p["i1"], c)
                    continue

        merged.append(p)
    return merged


def segment_stroke(points, epsilon, tol):
    """
    ストロークを「線分」と「円弧」の列に分解する。
    RDPで求めた頂点を切れ目の候補として、各位置から一番長く伸ばせる形状を貪欲に選ぶ。
    """
    idx = douglas_peucker_indices(points, epsilon)
    prims = []

    i = 0
    while i < len(idx) - 1:
        # --- 直線として何区間まで伸ばせるか ---
        j_line = i + 1
        for j in range(i + 1, len(idx)):
            if line_error(points[idx[i] : idx[j] + 1]) <= tol:
                j_line = j
            else:
                break

        # --- 円弧として何区間まで伸ばせるか（円弧は最低2区間必要） ---
        j_arc, arc_fit = i, None
        for j in range(i + 2, len(idx)):
            sub = points[idx[i] : idx[j] + 1]
            c = fit_circle(sub)
            if c is None:
                break
            span = float(np.hypot(*(sub[-1] - sub[0])))
            # 半径が大きすぎる＝ほぼ直線なので円弧とはみなさない
            # （20倍だと、ほぼまっすぐな部材まで円弧と判定されて骨組みから外れてしまう）
            if c[2] > max(span, 1.0) * 5:
                break
            if arc_error(sub, c) <= tol:
                j_arc, arc_fit = j, c
            else:
                break

        # 長く説明できたほうを採用（同じなら線分を優先）
        if j_arc > j_line and arc_fit is not None:
            prims.append(make_arc(points, idx[i], idx[j_arc], arc_fit))
            i = j_arc
        else:
            prims.append(make_line(points, idx[i], idx[j_line]))
            i = j_line

    return idx, merge_primitives(points, prims, tol)


def primitive_xy(p, n=96):
    """図形を描くための座標列を返す"""
    if p["type"] == "線分":
        return np.array([p["start"], p["end"]], dtype=float)
    t = np.linspace(p["a0"], p["a1"], n)
    cx, cy = p["center"]
    return np.column_stack([cx + p["radius"] * np.cos(t), cy + p["radius"] * np.sin(t)])


# ==========================================================
# 部材角度の15°スナップ
#   draw_lib.py の judg_poly と同じ考え方。
#   1ストローク内で連続する線分をひとまとまり（多角線分）として扱い、
#     ・端の線分は外側の端点を固定して回す
#     ・間の線分は中点を中心に回す
#   角度を15°刻みに丸めたあと、隣り合う線分の交点を取り直して節点をつなぎ直す。
# ==========================================================
ANGLE_STEP = 15                      # 角度調整のパラメータ（何度刻みに丸めるか）


def line_angle(p, q):
    """2点の角度を求める（0〜360度）"""
    return math.degrees(math.atan2(q[1] - p[1], q[0] - p[0])) % 360


def cross_point(p, u, q, v, fallback, limit):
    """点p・方向uの直線と、点q・方向vの直線の交点

    平行なとき、または交点が元の節点から limit 以上離れるときは fallback を返す。
    """
    den = u[0] * v[1] - u[1] * v[0]
    if abs(den) < 1e-9:                       # 平行（丸めた結果、同じ角度になった）
        return fallback

    t = ((q[0] - p[0]) * v[1] - (q[1] - p[1]) * v[0]) / den
    c = np.asarray(p, dtype=float) + t * np.asarray(u, dtype=float)
    if float(np.hypot(*(c - fallback))) > limit:
        return fallback
    return c


def _snap_chain(pts, step, close_tol):
    """つながった折れ線の各辺の角度を step 度刻みに丸め、新しい節点列を返す"""
    pts = [np.array(p, dtype=float) for p in pts]
    n = len(pts) - 1                                  # 辺の数
    angles = [(round(line_angle(pts[k], pts[k + 1]) / step) * step) % 360
              for k in range(n)]

    # 丸めた結果が同じ角度になった辺どうしは1本の直線としてまとめる
    groups = []
    for k in range(n):
        if groups and angles[k] == angles[groups[-1][0]]:
            groups[-1].append(k)
        else:
            groups.append([k])

    new_pts = [None] * (n + 1)
    lines = []                                        # 各グループの直線 (通る点, 方向ベクトル)

    for gi, g in enumerate(groups):
        a = math.radians(angles[g[0]])
        u = np.array([math.cos(a), math.sin(a)])

        idx = list(range(g[0], g[-1] + 2))            # このグループが持つ節点の添字
        seg = [pts[i] for i in idx]
        acc = [0.0]                                   # 元の折れ線に沿った累積長
        for i in range(len(seg) - 1):
            acc.append(acc[-1] + float(np.hypot(*(seg[i + 1] - seg[i]))))

        if len(groups) == 1 or (gi > 0 and gi < len(groups) - 1):
            anchor, s_a = (seg[0] + seg[-1]) / 2, acc[-1] / 2   # 間の辺は中点を中心に回す
        elif gi == 0:
            anchor, s_a = seg[0], 0.0                           # 始めの辺は始点を固定
        else:
            anchor, s_a = seg[-1], acc[-1]                      # 終わりの辺は終点を固定

        for i, t in zip(idx, acc):
            new_pts[i] = anchor + (t - s_a) * u
        lines.append((anchor, u, acc[-1]))     # (通る点, 方向, グループの長さ)

    # 角度の違う直線どうしは、交点を取り直して節点をつなぎ直す
    for gi in range(len(groups) - 1):
        j = groups[gi][-1] + 1
        a, ua, la = lines[gi]
        b, ub, lb = lines[gi + 1]
        new_pts[j] = cross_point(a, ua, b, ub, new_pts[j], max(la, lb))

    # 始点と終点が近ければ多角形とみなし、終わりの辺と始めの辺の交点で閉じる
    if len(groups) > 2 and float(np.hypot(*(pts[0] - pts[-1]))) < close_tol:
        a, ua, la = lines[-1]
        b, ub, lb = lines[0]
        mid = (new_pts[0] + new_pts[-1]) / 2
        c = cross_point(a, ua, b, ub, mid, max(la, lb))
        new_pts[0] = new_pts[-1] = c

    return new_pts


def snap_line_angles(prims, step=ANGLE_STEP, close_tol=25.0):
    """1ストローク分のプリミティブについて、線分の角度を step 度刻みに丸める"""
    prims = list(prims)

    i = 0
    while i < len(prims):
        if prims[i]["type"] != "線分":
            i += 1
            continue

        j = i
        while j < len(prims) and prims[j]["type"] == "線分":   # 連続する線分のまとまり
            j += 1

        chain = [prims[i]["start"]] + [p["end"] for p in prims[i:j]]
        new_pts = _snap_chain(chain, step, close_tol)

        for k, p in enumerate(prims[i:j]):
            p["start"], p["end"] = new_pts[k], new_pts[k + 1]
            p["length"] = float(np.hypot(*(new_pts[k + 1] - new_pts[k])))

        i = j

    return prims


# ==========================================================
# 清書結果をキャンバスに戻すための fabric.js オブジェクト生成
# ==========================================================
def to_fabric_path(xy, color, stroke_width):
    """点列を fabric.js の path オブジェクト（辞書）に変換する"""
    xy = np.asarray(xy, dtype=float)
    cmds = [["M", float(xy[0, 0]), float(xy[0, 1])]]
    cmds += [["L", float(x), float(y)] for x, y in xy[1:]]

    minx, miny = xy.min(axis=0)
    maxx, maxy = xy.max(axis=0)
    return {
        "type": "path", "version": "4.4.0", "originX": "left", "originY": "top",
        "left": float(minx), "top": float(miny),
        "width": float(maxx - minx), "height": float(maxy - miny),
        "fill": None, "stroke": color, "strokeWidth": stroke_width,
        "strokeDashArray": None, "strokeLineCap": "round", "strokeDashOffset": 0,
        "strokeLineJoin": "round", "strokeUniform": False, "strokeMiterLimit": 10,
        "scaleX": 1, "scaleY": 1, "angle": 0, "flipX": False, "flipY": False,
        "opacity": 1, "shadow": None, "visible": True, "backgroundColor": "",
        "fillRule": "nonzero", "paintFirst": "fill",
        "globalCompositeOperation": "source-over", "skewX": 0, "skewY": 0,
        "path": cmds,
    }


# ==========================================================
# 骨組みモデル（節点・部材）の構築
#   線分プリミティブだけを部材として扱う。円弧は解析対象外。
#   キャンバスは y が下向きなので、モデルは y を反転して保持する（y上向き）。
# ==========================================================
def to_math(p):
    """キャンバス座標 → 数学座標（y上向き）"""
    return np.array([p[0], CANVAS_H - p[1]], dtype=float)


def to_canvas(p):
    """数学座標 → キャンバス座標"""
    return np.array([p[0], CANVAS_H - p[1]], dtype=float)


def point_on_segment(a, b, c, tol):
    """線分 ab 上に点 c が乗っているか（乗っていれば端点からの距離を返す）"""
    ab = b - a
    L2 = float(ab @ ab)
    if L2 < 1e-12:
        return None
    t = float((c - a) @ ab) / L2
    if not (1e-6 < t < 1 - 1e-6):
        return None
    foot = a + t * ab
    if float(np.hypot(*(c - foot))) > tol:
        return None
    return t


def build_frame(prims, node_tol):
    """線分プリミティブから node_df / line_df を作る（座標は数学座標のpx）"""
    segments = [(to_math(p["start"]), to_math(p["end"]))
                for p in prims if p["type"] == "線分"]
    # 長さが節点判定距離に満たない線分は、節点を増やすだけなので捨てる
    segments = [(a, b) for a, b in segments if float(np.hypot(*(b - a))) > node_tol]

    nodes = []                       # 節点座標のリスト

    def node_id(p):
        """近い既存節点があればその番号、無ければ新規登録"""
        for i, q in enumerate(nodes):
            if float(np.hypot(*(p - q))) <= node_tol:
                return i
        nodes.append(np.array(p, dtype=float))
        return len(nodes) - 1

    members = []
    for a, b in segments:
        ia, ib = node_id(a), node_id(b)
        if ia != ib:
            members.append([ia, ib])

    # 部材の途中に他の節点が乗っている場合は、そこで部材を分割する
    changed = True
    while changed:
        changed = False
        for m_i, (ia, ib) in enumerate(list(members)):
            a, b = nodes[ia], nodes[ib]
            hits = []
            for k in range(len(nodes)):
                if k in (ia, ib):
                    continue
                t = point_on_segment(a, b, nodes[k], node_tol)
                if t is not None:
                    hits.append((t, k))
            if hits:
                hits.sort()
                chain = [ia] + [k for _, k in hits] + [ib]
                members.pop(m_i)
                members.extend([[chain[i], chain[i + 1]] for i in range(len(chain) - 1)])
                changed = True
                break

    # 重複部材の除去
    seen, uniq = set(), []
    for ia, ib in members:
        key = tuple(sorted((ia, ib)))
        if key not in seen:
            seen.add(key)
            uniq.append([ia, ib])

    node_df = pd.DataFrame(
        [{"No": i, "x": float(p[0]), "y": float(p[1])} for i, p in enumerate(nodes)]
    )
    line_df = pd.DataFrame(
        [{"s_node": ia, "e_node": ib} for ia, ib in uniq]
    )
    if len(node_df) == 0:
        node_df = pd.DataFrame(columns=["No", "x", "y"])
    if len(line_df) == 0:
        line_df = pd.DataFrame(columns=["s_node", "e_node"])
    return node_df, line_df


def nearest_node(node_df, p, tol):
    """数学座標 p に最も近い節点番号（tol以内）"""
    if len(node_df) == 0:
        return None
    d = np.hypot(node_df["x"].values - p[0], node_df["y"].values - p[1])
    i = int(np.argmin(d))
    return int(node_df["No"].iloc[i]) if d[i] <= tol else None


# ==========================================================
# 支点・荷重条件
#   節点番号は清書のたびに振り直されるので、条件は「座標」で保持して毎回マッピングする
# ==========================================================
BLANK_COND = {"stick": 0, "s_ang": 0.0, "point": 0, "point_ang": 270.0,
              "moment": 0, "moment_dir": 0}
STICK_NAME = {0: "-", 1: "ピン", 2: "ローラー", 3: "固定"}


def conditions_to_df(conditions, node_df, tol):
    """条件リストを input_df（節点番号つき）に変換する"""
    rows = []
    for c in conditions:
        no = nearest_node(node_df, np.array([c["x"], c["y"]]), tol)
        if no is None:
            continue
        row = {"No": no}
        row.update({k: c[k] for k in BLANK_COND})
        rows.append(row)

    if not rows:
        return pd.DataFrame(columns=["No"] + list(BLANK_COND))
    df = pd.DataFrame(rows)
    return df.groupby("No", as_index=False).last()


def make_dfs(node_df, line_df, input_df, E, A, I, scale, P, M0):
    """FEMプログラムへ渡すためのデータ作成（draw_lib.py の make_dfs と同じ列構成）"""
    nodes = node_df.copy()
    nodes["x"] = nodes["x"] * scale          # px → m
    nodes["y"] = nodes["y"] * scale
    for col in ["rc_x", "rc_y", "rc_m", "ef_x", "ef_y", "ef_m", "s_ang"]:
        nodes[col] = 0.0

    for _, r in input_df.iterrows():
        m = nodes["No"] == r["No"]
        if r["stick"] == 1:                  # ピン支点
            nodes.loc[m, ["rc_x", "rc_y"]] = [1, 1]
        elif r["stick"] == 2:                # ローラー支点
            # s_ang を与えると節点座標系ごと傾き、傾斜ローラーになる
            nodes.loc[m, "rc_y"] = 1
            nodes.loc[m, "s_ang"] = float(r.get("s_ang", 0.0))
        elif r["stick"] == 3:                # 固定支点
            nodes.loc[m, ["rc_x", "rc_y", "rc_m"]] = [1, 1, 1]

        if r["point"] == 1:                  # 集中荷重（point_ang 方向に大きさ P）
            a = math.radians(float(r["point_ang"]))
            nodes.loc[m, "ef_x"] += P * math.cos(a)
            nodes.loc[m, "ef_y"] += P * math.sin(a)

        if r["moment"] == 1:                 # モーメント荷重
            nodes.loc[m, "ef_m"] += M0 if r["moment_dir"] == 0 else -M0

    rows = []
    for _, r in line_df.iterrows():
        p = nodes[nodes["No"] == r["s_node"]][["x", "y"]].values[0].astype(float)
        q = nodes[nodes["No"] == r["e_node"]][["x", "y"]].values[0].astype(float)
        rows.append({
            "young": E, "area": A, "s_moment": I,
            "length": float(np.hypot(*(q - p))),
            "angle": math.degrees(math.atan2(q[1] - p[1], q[0] - p[0])) % 360,
            "start": int(r["s_node"]), "end": int(r["e_node"]),
            "Ws": 0.0, "We": 0.0,
        })
    elements_df = pd.DataFrame(
        rows, columns=["young", "area", "s_moment", "length", "angle", "start", "end", "Ws", "We"]
    )
    nodes_df = nodes[["No", "x", "y", "rc_x", "rc_y", "rc_m",
                      "ef_x", "ef_y", "ef_m", "s_ang"]]
    return elements_df, nodes_df


# ==========================================================
# キャンバスに描く記号（支点・荷重）
# ==========================================================
def cond_symbols(node_df, input_df, stroke_width):
    """支点・荷重を表す fabric オブジェクトのリスト（キャンバス座標）"""
    objs = []
    for _, r in input_df.iterrows():
        hit = node_df[node_df["No"] == r["No"]]
        if len(hit) == 0:
            continue
        cx, cy = to_canvas(hit[["x", "y"]].values[0].astype(float))

        if r["stick"] in (1, 2):                          # ピン / ローラー
            objs.append(to_fabric_path(
                [[cx, cy], [cx - 11, cy + 19], [cx + 11, cy + 19], [cx, cy]],
                COND_COLOR, stroke_width))
            if r["stick"] == 2:                           # ローラーは下に線を1本
                objs.append(to_fabric_path(
                    [[cx - 13, cy + 24], [cx + 13, cy + 24]], COND_COLOR, stroke_width))
        elif r["stick"] == 3:                             # 固定
            objs.append(to_fabric_path(
                [[cx - 16, cy], [cx + 16, cy]], COND_COLOR, stroke_width))
            for k in range(-3, 4):                        # ハッチング
                objs.append(to_fabric_path(
                    [[cx + k * 5, cy], [cx + k * 5 - 6, cy + 10]], COND_COLOR, 1))

        if r["point"] == 1:                               # 集中荷重（矢印）
            a = math.radians(float(r["point_ang"]))
            d = np.array([math.cos(a), -math.sin(a)])     # キャンバスは y 下向き
            tail = np.array([cx, cy]) - d * 45
            head = np.array([cx, cy]) - d * 4
            n = np.array([-d[1], d[0]])
            objs.append(to_fabric_path([tail, head], COND_COLOR, stroke_width))
            objs.append(to_fabric_path(
                [head - d * 10 + n * 5, head, head - d * 10 - n * 5], COND_COLOR, stroke_width))

        if r["moment"] == 1:                              # モーメント荷重（円弧＋矢じり）
            sign = 1 if r["moment_dir"] == 0 else -1
            t = np.linspace(math.radians(40), math.radians(300), 40)[::sign]
            arc = np.column_stack([cx + 18 * np.cos(t), cy - 18 * np.sin(t)])
            objs.append(to_fabric_path(arc, COND_COLOR, stroke_width))
            tip, prev = arc[-1], arc[-4]
            d = (tip - prev) / max(np.hypot(*(tip - prev)), 1e-9)
            n = np.array([-d[1], d[0]])
            objs.append(to_fabric_path(
                [tip - d * 9 + n * 5, tip, tip - d * 9 - n * 5], COND_COLOR, stroke_width))

    return objs


def node_marker(cx, cy, r=4):
    """節点を表す小さなひし形（クリック入力の circle と区別するため path で描く）"""
    return to_fabric_path(
        [[cx, cy - r], [cx + r, cy], [cx, cy + r], [cx - r, cy], [cx, cy - r]],
        NODE_COLOR, 2)


def render_objects(stroke_width, show_nodes=True):
    """キャンバスに読み込ませる図形リストを組み立てる"""
    objs = []
    for p in st.session_state.prims:
        color = LINE_COLOR if p["type"] == "線分" else ARC_COLOR
        objs.append(to_fabric_path(primitive_xy(p), color, stroke_width))

    node_df = st.session_state.node_df
    input_df = conditions_to_df(st.session_state.conditions, node_df, NODE_TOL)
    objs.extend(cond_symbols(node_df, input_df, stroke_width))

    if show_nodes:
        for _, r in node_df.iterrows():
            cx, cy = to_canvas(np.array([r["x"], r["y"]], dtype=float))
            objs.append(node_marker(cx, cy))

    return {"version": "4.4.0", "objects": objs}


def refresh(stroke_width, show_nodes):
    """モデルを組み直してキャンバスを描き直す"""
    st.session_state.node_df, st.session_state.line_df = build_frame(
