# ==========================================================
# 応力図の作図
# ==========================================================
def diagram_figure(dfs, node_df, line_df, key, mag, scale, title):
    """N図 / Q図 / M図 / 変形図を matplotlib で描く

    key : "N" / "Q" / "M" / "deform"
    mag : 表示倍率（px）
    """
    fig, ax = plt.subplots(figsize=(6.4, 4.4), dpi=130)

    # --- 骨組み（灰色） ---
    for _, r in line_df.iterrows():
        p = node_df[node_df["No"] == r["s_node"]][["x", "y"]].values[0].astype(float)
        q = node_df[node_df["No"] == r["e_node"]][["x", "y"]].values[0].astype(float)
        ax.plot([p[0], q[0]], [p[1], q[1]], color="0.55", lw=1.6, zorder=2)

    if key == "deform":
        vmax = max((float(np.max(np.hypot(d["dx"], d["dy"]))) for d in dfs if len(d)), default=0.0)
        for d in dfs:
            if len(d) == 0:
                continue
            # 骨組みはpx、変位はmなので、それぞれ単位を揃えてから足す
            k = (mag / vmax) if vmax > 0 else 0.0
            ax.plot(d["x"] / scale + d["dx"] * k, d["y"] / scale + d["dy"] * k,
                    color="#d62728", lw=2.0, zorder=3)
        ax.set_title(f"{title}   (max disp = {vmax:.4g} m)", fontsize=10)
    else:
        vmax = max((float(np.max(np.abs(d[key]))) for d in dfs if len(d)), default=0.0)
        k = (mag / vmax) if vmax > 0 else 0.0

        pos_color = {"N": "#d62728", "Q": "#1f77b4", "M": "#2ca02c"}[key]
        neg_color = {"N": "#1f77b4", "Q": "#ff7f0e", "M": "#9467bd"}[key]

        for d in dfs:
            if len(d) == 0:
                continue
            base = np.column_stack([d["x"].values, d["y"].values]) / scale
            ang = math.atan2(base[-1, 1] - base[0, 1], base[-1, 0] - base[0, 0])
            normal = np.array([-math.sin(ang), math.cos(ang)])   # 部材直交方向

            v = d[key].values
            # M は下側引張が正なので、正の値を材の下側（-法線側）に描く
            off = base + np.outer(-v * k if key == "M" else v * k, normal)

            for i in range(len(base) - 1):
                poly = np.array([base[i], base[i + 1], off[i + 1], off[i]])
                vm = (v[i] + v[i + 1]) / 2
                ax.fill(poly[:, 0], poly[:, 1], color=pos_color if vm >= 0 else neg_color,
                        alpha=0.30, lw=0, zorder=1)
            ax.plot(off[:, 0], off[:, 1], color="0.2", lw=1.2, zorder=3)

        unit = "kN" if key in ("N", "Q") else "kN·m"
        ax.set_title(f"{title}   (max |{key}| = {vmax:.4g} {unit})", fontsize=10)

    ax.set_aspect("equal")
    ax.set_xticks([])
    ax.set_yticks([])
    for s in ax.spines.values():
        s.set_color("0.85")
    ax.margins(0.18)
    fig.tight_layout()
    return fig


